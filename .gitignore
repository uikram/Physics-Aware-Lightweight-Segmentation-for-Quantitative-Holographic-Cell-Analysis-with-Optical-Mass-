# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# --- Model weights and caches ---------------------------------------------
# Pretrained encoders (mobile_sam.pt, edge_sam_3x.pth) are ~40 MB each.
weights/
cache/
*.pt
*.pth
*.onnx
*.ckpt
**/checkpoints/

# --- Data ------------------------------------------------------------------
# Phase maps are not redistributed; data/processed is rebuilt by
# scripts/prepare_dataset.py.
data/raw_data/
data/dataset/
data/X_train_raw/
data/processed/
data/processed_smoke/
*.tif
*.tiff
*.TIF
*.TIFF

# --- Run outputs -----------------------------------------------------------
# Per-run training artefacts are regenerated by the pipeline and are large.
# The compiled summaries, run_metadata.json and grid.json stay tracked so the
# manuscript numbers can be checked without a GPU.
outputs/*/runs/
outputs/cell_analysis/runs/
outputs/smoke/
**/logs/
*.npz
manuscript/outputs_smoke/

# --- Build / scratch -------------------------------------------------------
*.log
*.aux
*.out
*.synctex.gz
to_delete/
old_run/
.DS_Store
Thumbs.db

# Figures, tables, Markdown documentation and the manuscript LaTeX sources are
# tracked on purpose: they are the published record of the results.
